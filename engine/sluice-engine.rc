// sluice-engine.rc : sluice-engine.exe の Win32 バージョンリソース
// (実装ガイド §5.8)。engine/version.h と数値を一致させること。

#include <winres.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Sluice Project"
            VALUE "FileDescription", "Sluice audio routing engine"
            VALUE "FileVersion", "0.1.0.0"
            VALUE "InternalName", "sluice-engine"
            VALUE "OriginalFilename", "sluice-engine.exe"
            VALUE "ProductName", "Sluice"
            VALUE "ProductVersion", "0.1.0.0"
            VALUE "LegalTrademarks", "ASIO is a trademark and software of Steinberg Media Technologies GmbH"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
