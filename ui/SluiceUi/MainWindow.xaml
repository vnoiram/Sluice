<Window x:Class="SluiceUi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sluice" Height="480" Width="720"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="StatusText" Grid.Row="0" Text="Engine: disconnected"
                   FontWeight="Bold" Margin="0,0,0,8"/>

        <Button x:Name="ConnectButton" Grid.Row="1" Content="Connect"
                Click="ConnectButton_Click" Width="100" HorizontalAlignment="Left"/>

        <TabControl Grid.Row="3" Grid.RowSpan="2" Margin="0,8,0,0">
            <TabItem Header="Devices">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- デバイス一覧(実装ガイド §5.6「UI に必ず出すもの: 各デバイスの
                         レーン、実効レイテンシ、xrun カウンタ、ASRC の現在比」)。
                         engine からの push 通知(devices_changed)を受けて自動更新する。 -->
                    <DataGrid x:Name="DevicesGrid" Grid.Row="0"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
                            <DataGridTextColumn Header="Backend" Binding="{Binding Backend}" Width="*"/>
                            <DataGridTextColumn Header="Dir" Binding="{Binding Direction}" Width="*"/>
                            <DataGridTextColumn Header="Lane" Binding="{Binding Lane}" Width="*"/>
                            <DataGridTextColumn Header="Latency (ms)" Binding="{Binding EffectiveLatencyMs, StringFormat=F2}" Width="*"/>
                            <!-- gap 8: tools/latencybench の JSON 出力オプションによる実測値
                                 (main.cpp が ipc::LookupMeasuredLatencyMs でマージ)。0 = 未測定。 -->
                            <DataGridTextColumn Header="Measured (ms)" Binding="{Binding MeasuredLatencyMs, StringFormat=F2}" Width="*"/>
                            <DataGridTextColumn Header="xrun" Binding="{Binding XrunCount}" Width="*"/>
                            <DataGridTextColumn Header="ASRC ratio" Binding="{Binding AsrcRatio, StringFormat=F7}" Width="1.3*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBox x:Name="LogBox" Grid.Row="1" Margin="0,8,0,0"
                             IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                             TextWrapping="Wrap" FontFamily="Consolas"/>
                </Grid>
            </TabItem>

            <!-- ミキサー操作(gap 10)。engine 側 IPC(set_param 等)は
                 EngineClient に既に実装済みだったが、UI 側の配線が無かった。 -->
            <TabItem Header="Mixer">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="StripsGrid" Grid.Row="0" Grid.Column="0"
                              AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column"
                              SelectionChanged="StripsGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Strip" Binding="{Binding Label}" Width="2*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Gain (dB)" Binding="{Binding GainDb, Mode=TwoWay, StringFormat=F1}" Width="*"/>
                            <DataGridCheckBoxColumn Header="Mute" Binding="{Binding Mute, Mode=TwoWay}" Width="Auto"/>
                            <DataGridCheckBoxColumn Header="Solo" Binding="{Binding Solo, Mode=TwoWay}" Width="Auto"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 選択中ストリップのバス別ルーティングセンドゲイン。 -->
                    <GroupBox Grid.Row="0" Grid.Column="1" Header="Routing to buses" Margin="8,0,0,0">
                        <DataGrid x:Name="RoutingGrid" AutoGenerateColumns="False"
                                  CanUserAddRows="False" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Bus" Binding="{Binding BusLabel}" Width="2*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Send (dB)" Binding="{Binding GainDb, Mode=TwoWay, StringFormat=F1}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <DataGrid x:Name="BusesGrid" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                              Margin="0,8,0,0" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Bus" Binding="{Binding Label}" Width="2*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Gain (dB)" Binding="{Binding GainDb, Mode=TwoWay, StringFormat=F1}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
